# Database Configuration
DATABASE_URL=postgresql://<user>:<password>@<your-endpoint>.neon.tech/<dbname>?sslmode=require&channel_binding=require

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_must_be_long_and_random
JWT_ALGORITHM=HS256

# Storage Configuration
STORAGE_URL=https://your-storage-bucket.s3.amazonaws.com
STORAGE_KEY=your_storage_access_key

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/applycm

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_must_be_long_and_random
JWT_ALGORITHM=HS256

# Storage Configuration
STORAGE_URL=https://your-storage-bucket.s3.amazonaws.com
STORAGE_KEY=your_storage_access_key

# Application emails (submitting the profile PDF to universities)
# EMAIL_BACKEND=console only logs emails; use it for local development.
EMAIL_BACKEND=brevo
BREVO_API_KEY=your_brevo_api_key
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs).
EMAIL_FROM_ADDRESS=applications@example.com
EMAIL_FROM_NAME=ApplyCM
# Optional: send every email here instead of the real school while testing.
EMAIL_REDIRECT_TO=
